{
  "info": {
    "name": "Food Platform Logistics API",
    "description": "Postman collection for the logistics and fulfillment backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login buyer",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"buyer@demo.local\",\n  \"role\": \"buyer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create order",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{jwtToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"buyer_id\": 1,\n  \"seller_id\": 2,\n  \"requested_slot\": \"18:30\",\n  \"items\": [\n    {\"menu_item_id\": 101, \"quantity\": 2, \"unit_price\": 120.0}\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"]
            }
          }
        },
        {
          "name": "List orders",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{jwtToken}}"}
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"]
            }
          }
        }
      ]
    },
    {
      "name": "Batches",
      "item": [
        {
          "name": "Create batch",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{jwtToken}}"}
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/batches?seller_id=2",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "batches"],
              "query": [
                {"key": "seller_id", "value": "2"}
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Pickups",
      "item": [
        {
          "name": "Verify pickup",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{jwtToken}}"}
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pickups/verify?order_id=1&buyer_id=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pickups", "verify"],
              "query": [
                {"key": "order_id", "value": "1"},
                {"key": "buyer_id", "value": "1"}
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Dashboard overview",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{jwtToken}}"}
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/analytics/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "analytics", "dashboard"]
            }
          }
        }
      ]
    }
  ]
}
